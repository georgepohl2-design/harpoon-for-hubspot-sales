{
  "manifest_version": 3,
  "name": "Harpoon: Target Account Board",
  "short_name": "Harpoon",
  "version": "0.1.0",
  "description": "Your top 100 target accounts on one board, plus a Slack notification that gets your sales team on it. Reads from HubSpot.",
  "action": {
    "default_title": "Harpoon",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://api.hubapi.com/*",
    "https://hooks.slack.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://georgepohl2-design.github.io/harpoon/open/*"],
      "js": ["content/open-link.js"],
      "run_at": "document_start"
    }
  ]
}
